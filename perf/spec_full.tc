int gv = 100;
const int gc = 50;
void noop() { }
int add3(int a, int b, int c) { return a + b + c; }
int gcd(int a, int b) {
    while (b != 0) { int t = b; b = a % b; a = t; }
    return a;
}
int main() {
    noop();
    int x = 5;
    int r = 0;
    if (x > 3) r = 1; else r = 2;
    if (x > 10) r = r + 100;
    if (x == 1) r = r + 1;
    else if (x == 5) r = r + 10;
    else r = r + 100;
    int a = 10;
    int b = 3;
    r = r + (a + b) + (a - b) + (a * b) + (a / b) + (a % b);
    int s = 0;
    if (a > 5 && b < 10) s = 1;
    if (a < 5 || b > 2) s = s + 2;
    if (!(a < 5)) s = s + 4;
    int i = 0;
    while (i < 100) {
        i = i + 1;
        if (i % 10 == 0) continue;
        if (i > 25) break;
        s = s + 1;
    }
    int t = 1;
    { int t = 2; { int t = 3; r = r + t; } r = r + t; }
    r = r + t;
    const int c1 = 5 + 5;
    const int c2 = c1 * 2 + gc;
    r = r + c1 + c2;
    r = r + gv + gc;
    r = r + add3(1, 2, 3);
    r = r + gcd(48, 18);
    return r % 256;
}
