int sum12(int a1,int a2,int a3,int a4,int a5,int a6,int a7,int a8,int a9,int a10,int a11,int a12) {
    return a1+a2+a3+a4+a5+a6+a7+a8+a9+a10+a11+a12;
}
int main() {
    int v1 = 1;
    int v2 = 2;
    int v3 = 3;
    int v4 = 4;
    int v5 = 5;
    int v6 = 6;
    int v7 = 7;
    int v8 = 8;
    int v9 = 9;
    int v10 = 10;
    int w1 = 11;
    int w2 = 12;
    int w3 = 13;
    int w4 = 14;
    int w5 = 15;
    int r = sum12(v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, w1, w2);
    return r + w3 + w4 + w5;
}
